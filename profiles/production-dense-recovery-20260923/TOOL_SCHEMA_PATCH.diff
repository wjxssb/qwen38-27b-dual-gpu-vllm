+def _validate_tool_schema_types(schema: dict[str, Any], parameter: str) -> None:
+    """Reject invalid type keywords without imposing a JSON Schema dialect.
+
+    Visit schema positions only: enum/const/default/examples and extension
+    objects contain instance data, where a field named "type" is unrestricted.
+    Other schema validity and backend support remain native backend concerns.
+    """
+    pending: list[tuple[Any, str]] = [(schema, parameter)]
+    visited: set[int] = set()
+    while pending:
+        node, path = pending.pop()
+        if not isinstance(node, dict) or id(node) in visited:
+            continue
+        visited.add(id(node))
+        if "type" in node:
+            value = node["type"]
+            valid = isinstance(value, str) and value in _JSON_SCHEMA_TYPES
+            if isinstance(value, list):
+                valid = (
+                    bool(value)
+                    and all(isinstance(item, str) and item in _JSON_SCHEMA_TYPES
+                            for item in value)
+                    and len(set(value)) == len(value)
+                )
+            if not valid:
+                raise VLLMValidationError(
+                    "JSON Schema 'type' must be a JSON type name or a non-empty "
+                    "array of distinct JSON type names.",
+                    parameter=f"{path}.type",
+                )
+        for keyword in (
+            "$defs", "definitions", "properties", "patternProperties",
+            "dependentSchemas", "dependencies",
+        ):
+            children = node.get(keyword)
+            if isinstance(children, dict):
+                pending.extend((child, f"{path}.{keyword}.{name}")
+                               for name, child in children.items()
+                               if isinstance(child, dict))
+        for keyword in (
+            "items", "additionalItems", "additionalProperties", "contains",
+            "propertyNames", "not", "if", "then", "else", "unevaluatedItems",
+            "unevaluatedProperties", "contentSchema",
+        ):
+            child = node.get(keyword)
+            if isinstance(child, dict):
+                pending.append((child, f"{path}.{keyword}"))
+            elif keyword == "items" and isinstance(child, list):
+                pending.extend((item, f"{path}.{keyword}.{index}")
+                               for index, item in enumerate(child))
+        for keyword in ("allOf", "anyOf", "oneOf", "prefixItems"):
+            children = node.get(keyword)
+            if isinstance(children, list):
+                pending.extend((child, f"{path}.{keyword}.{index}")
+                               for index, child in enumerate(children))
 
 
