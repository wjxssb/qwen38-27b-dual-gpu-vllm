CUDA_DEVICE_ORDER=PCI_BUS_ID
FLASHINFER_NVCC_THREADS=1
FLASHINFER_WORKSPACE_BASE=/cache/flashinfer
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_OFFLINE=1
MAX_JOBS=1
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=0
PYTHONUNBUFFERED=1
TMPDIR=/cache
TRANSFORMERS_OFFLINE=1
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=900
VLLM_FLASHINFER_AUTOTUNE_CACHE_DIR=/cache/autotune
VLLM_KV_CACHE_LAYOUT=HND
VLLM_NO_USAGE_STATS=1
VLLM_SM120_MTP_DECODE_GRAPH=1
VLLM_SM120_MTP_GRAPH_EVIDENCE_DIR=/results
VLLM_SM120_NVFP4_K3_GRAPH=1
VLLM_SM120_NVFP4_K3_NATIVE=1
VLLM_TP_GENERATION_LIFECYCLE=1
VLLM_USE_V2_MODEL_RUNNER=0
