# ==============================================================================
# Qwen3.8-27B Dual GPU Deployment Configuration
# Copy this file to config.env to customize your deployment.
# ==============================================================================

# Port exposed on host (Default: 18094)
HOST_PORT=18094

# GPUs to allocate (e.g. "all", "0,1", or specific device IDs)
GPU_DEVICES="all"

# Model identifier on Hugging Face (or local path to safetensors)
MODEL_NAME="unsloth/Qwen3.8-27B-NVFP4"
SERVED_MODEL_NAME="unsloth/Qwen3.8-27B-NVFP4"

# Pinned Model Git Revision (Exact commit hash verified in benchmarks)
MODEL_REVISION="57926baca9a82b4d6906b43f2750d55315f5b10f"

# Host path for HuggingFace model cache (Default: ~/.cache/huggingface)
HF_CACHE_DIR="${HOME}/.cache/huggingface"

# Optional: HuggingFace Token for gated access or higher rate limits
# HF_TOKEN="hf_xxxxxxxxxxxxxxxxxxxx"

# Optional: Override Docker image. The default is the immutable, public digest below.
# DOCKER_IMAGE="ghcr.io/wjxssb/qwen38-27b-vllm:sm120-nvfp4-k3"
# 启动器（./launch.sh）按 digest 钉死拉取公开定制运行时镜像；compose 为高级手动路径。

# Maximum context length (Tokens). Fully verified up to 262144 (262K).
MAX_MODEL_LEN=262144

# KV cache data type (nvfp4 for 4-bit KV, fp8, or auto)
KV_CACHE_DTYPE="nvfp4"

# Multi-Token Prediction (MTP) Speculative Tokens (3 is verified optimal)
MTP_SPEC_TOKENS=3

# Prefill Chunk Size (4096 gives +6.67% prompt processing throughput over 2048)
MAX_NUM_BATCHED_TOKENS=4096

# Container memory limits
HOST_MEM_LIMIT="48g"
